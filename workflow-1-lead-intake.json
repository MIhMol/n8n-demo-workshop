                  {
                      "parameters":  {
                                         "jsCode":  "const SYSTEM_PROMPT = `You are a contact-form classifier for a small B2B services business. You receive a single inbound submission with name, email, and message. Return JSON only with these exact keys:\n\n- is_lead (boolean): true if this is a genuine business inquiry, false otherwise\n- is_spam (boolean): true if this is SEO outreach, link-building, crypto, casino, mass-sent template, or otherwise auto-generated spam\n- urgency_score (integer 1-10): 1 = no time pressure, 10 = needs response within one hour (existing-customer escalation, deadline cited, or explicit urgency words)\n- intent_category (string): one of pricing, support, demo, partnership, spam, other\n- suggested_next_action (string): one short sentence on what the recipient should do next\n\nOutput JSON only. No prose, no markdown, no preamble.`;\n\nconst lead = $input.first().json.body ?? {};\nconst userMessage = `Name: ${lead.name ?? \u0027(missing)\u0027}\nEmail: ${lead.email ?? \u0027(missing)\u0027}\nMessage: ${lead.message ?? \u0027(missing)\u0027}`;\n\nreturn [{\n  json: {\n    model: \u0027claude-haiku-4-5-20251001\u0027,\n    max_tokens: 256,\n    system: SYSTEM_PROMPT,\n    messages: [{ role: \u0027user\u0027, content: userMessage }],\n  }\n}];\n"
                                     },
                      "id":  "2cd6d99e-ec84-490f-84ef-ca4560c96bab",
                      "name":  "Build Anthropic Payload",
                      "type":  "n8n-nodes-base.code",
