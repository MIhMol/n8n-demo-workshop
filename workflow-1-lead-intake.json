                      "id":  "33e23c9f-38f2-4735-8d27-217757594335",
                      "name":  "Anthropic Classify",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       -832,
                                       48
                                   ],
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  3000
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nconst out = [];\nfor (const item of items) {\n  let text = item.json.content?.[0]?.text ?? \u0027{}\u0027;\n  // Strip markdown code fences (Claude sometimes wraps JSON in ```json ... ```)\n  text = text.trim().replace(/^```(?:json)?\\s*/i, \u0027\u0027).replace(/\\s*```\\s*$/, \u0027\u0027).trim();\n  // Fallback: extract first {...} block in case any prose snuck in\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) text = jsonMatch[0];\n\n  let parsed;\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      is_lead: false,\n      is_spam: false,\n      urgency_score: 1,\n      intent_category: \u0027other\u0027,\n      suggested_next_action: \u0027Classifier parse failed; review manually\u0027,\n    };\n  }\n  const webhook = $(\u0027Webhook\u0027).first().json.body ?? {};\n  out.push({\n    json: {\n      name: webhook.name ?? \u0027\u0027,\n      email: webhook.email ?? \u0027\u0027,\n      message: webhook.message ?? \u0027\u0027,\n      is_lead: !!parsed.is_lead,\n      is_spam: !!parsed.is_spam,\n      urgency_score: Number(parsed.urgency_score ?? 1),\n      intent_category: String(parsed.intent_category ?? \u0027other\u0027),\n      suggested_next_action: String(parsed.suggested_next_action ?? \u0027\u0027),\n    }\n  });\n}\nreturn out;"
                                     },
