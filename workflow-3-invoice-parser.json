                      "type":  "n8n-nodes-base.extractFromFile",
                      "typeVersion":  1,
                      "name":  "Extract PDF Text",
                      "id":  "51d90a66-843f-460f-96a6-4f3b181db049"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const SYSTEM_PROMPT = `You are an invoice extractor. Parse the provided text from a PDF invoice. Return JSON only with these exact keys:\n\n- vendor_name (string): the company that issued the invoice\n- invoice_number (string): the invoice\u0027s unique identifier\n- amount_total (number): the grand total in the original currency, no symbols\n- currency (string): 3-letter ISO code if visible (USD, EUR, GBP, etc.), or empty string if not visible\n- due_date (string): ISO date YYYY-MM-DD if visible, or null if not visible\n- line_items (array): list of {description: string, amount: number} objects\n\nOutput JSON only. No prose, no markdown, no preamble.`;\n\nconst items = $input.all();\nconst triggerItems = $(\u0027Drive Trigger\u0027).all();\nconst out = [];\nfor (let i = 0; i \u003c items.length; i++) {\n  const item = items[i];\n  const extractedText = item.json.text ?? \u0027(no text extracted)\u0027;\n  const trigger = triggerItems[i] ?? {};\n  const filename = (trigger.json \u0026\u0026 trigger.json.name) ? trigger.json.name : \u0027unknown.pdf\u0027;\n  const fileId = (trigger.json \u0026\u0026 trigger.json.id) ? trigger.json.id : \u0027\u0027;\n\n  const userMessage = `Invoice text:\\n\\n${String(extractedText).slice(0, 8000)}`;\n\n  out.push({\n    json: {\n      model: \u0027claude-haiku-4-5-20251001\u0027,\n      max_tokens: 1024,\n      system: SYSTEM_PROMPT,\n      messages: [{ role: \u0027user\u0027, content: userMessage }],\n      _file_meta: { filename, file_id: fileId }\n    }\n  });\n}\nreturn out;\n"
                                     },
                      "position":  [
                                       -608,
                                       80
                                   ],
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
