                                   ],
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "name":  "Anthropic Extract",
                      "id":  "ebcf6376-b7a7-4db9-b54b-3a9d054928cb",
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  3000
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nconst buildItems = $(\u0027Build Anthropic Payload\u0027).all();\nconst out = [];\nfor (let i = 0; i \u003c items.length; i++) {\n  const item = items[i];\n  let text = (item.json.content \u0026\u0026 item.json.content[0] \u0026\u0026 item.json.content[0].text) ? item.json.content[0].text : \u0027{}\u0027;\n  text = text.trim().replace(/^```(?:json)?\\s*/i, \u0027\u0027).replace(/\\s*```\\s*$/, \u0027\u0027).trim();\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) text = jsonMatch[0];\n\n  let parsed;\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      vendor_name: \u0027\u0027,\n      invoice_number: \u0027\u0027,\n      amount_total: 0,\n      currency: \u0027\u0027,\n      due_date: null,\n      line_items: [],\n    };\n  }\n\n  const meta = (buildItems[i] \u0026\u0026 buildItems[i].json._file_meta) ? buildItems[i].json._file_meta : {};\n  out.push({\n    json: {\n      vendor: String(parsed.vendor_name ?? \u0027\u0027),\n      invoice_number: String(parsed.invoice_number ?? \u0027\u0027),\n      amount: Number(parsed.amount_total ?? 0),\n      currency: String(parsed.currency ?? \u0027\u0027),\n      due_date: parsed.due_date ?? null,\n      line_items_text: JSON.stringify(parsed.line_items ?? [], null, 2),\n      source_file: meta.filename ?? \u0027\u0027,\n    }\n  });\n}\nreturn out;\n"
                                     },
