                      "typeVersion":  4.2,
                      "name":  "Anthropic Classify",
                      "id":  "1735f550-f07a-4fb4-bdf0-3bebffa65b4d",
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  3000
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nconst buildItems = $(\u0027Build Anthropic Payload\u0027).all();\nconst out = [];\nfor (let i = 0; i \u003c items.length; i++) {\n  const item = items[i];\n  let text = (item.json.content \u0026\u0026 item.json.content[0] \u0026\u0026 item.json.content[0].text) ? item.json.content[0].text : \u0027{}\u0027;\n  text = text.trim().replace(/^```(?:json)?\\s*/i, \u0027\u0027).replace(/\\s*```\\s*$/, \u0027\u0027).trim();\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) text = jsonMatch[0];\n\n  let parsed;\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      category: \u0027general\u0027,\n      urgency: 1,\n      suggested_reply: \u0027Classifier parse failed; review manually\u0027,\n      needs_human: true,\n    };\n  }\n\n  const meta = (buildItems[i] \u0026\u0026 buildItems[i].json._email_meta) ? buildItems[i].json._email_meta : {};\n  out.push({\n    json: {\n      subject: meta.subject ?? \u0027\u0027,\n      from_email: meta.from ?? \u0027\u0027,\n      snippet: meta.snippet ?? \u0027\u0027,\n      email_id: meta.email_id ?? \u0027\u0027,\n      category: String(parsed.category ?? \u0027general\u0027),\n      urgency: Number(parsed.urgency ?? 1),\n      suggested_reply: String(parsed.suggested_reply ?? \u0027\u0027),\n      needs_human: !!parsed.needs_human,\n    }\n  });\n}\nreturn out;"
                                     },
