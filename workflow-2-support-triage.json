                      "id":  "77ba52da-f92e-4fa6-a2bf-9981655478d8"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const SYSTEM_PROMPT = `You are a support ticket classifier. You receive a single inbound email with subject, from address, and snippet. Return JSON only with these exact keys:\n\n- category (string): one of support, bug, billing, general, spam\n- urgency (integer 1-5): 1 = no rush, 5 = production-down or active customer impact\n- suggested_reply (string): one-paragraph draft response in friendly professional tone\n- needs_human (boolean): true if Claude cannot generate a reply confidently, false otherwise\n\nOutput JSON only. No prose, no markdown, no preamble.`;\n\nconst items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const email = item.json;\n  const subject = email.subject ?? \u0027(no subject)\u0027;\n  let from = email.from;\n  if (from \u0026\u0026 from.value \u0026\u0026 from.value[0]) from = from.value[0].address;\n  if (typeof from !== \u0027string\u0027) from = \u0027(unknown sender)\u0027;\n  const snippet = email.snippet ?? (email.text ? email.text.slice(0, 800) : (email.textPlain ? email.textPlain.slice(0, 800) : \u0027(no body)\u0027));\n\n  const userMessage = `Subject: ${subject}\\nFrom: ${from}\\nSnippet: ${snippet}`;\n\n  out.push({\n    json: {\n      model: \u0027claude-haiku-4-5-20251001\u0027,\n      max_tokens: 512,\n      system: SYSTEM_PROMPT,\n      messages: [{ role: \u0027user\u0027, content: userMessage }],\n      _email_meta: { subject, from, snippet, email_id: email.id ?? \u0027\u0027 }\n    }\n  });\n}\nreturn out;"
                                     },
